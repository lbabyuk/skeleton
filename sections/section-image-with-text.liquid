{% style %}
  .section-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-top: {{ section.settings.padding_top_mb }}px;
    padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    background: {{ section.settings.bg_color }};
    align-items: stretch;
  }

  @media (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }}.flex-start .two-side__content {
    justify-content: flex-start;
  }
  .section-{{ section.id }}.center .two-side__content {
    justify-content: center;
  }
  .section-{{ section.id }}.flex-end .two-side__content {
    justify-content: flex-end;
  }

  .section-{{ section.id }}.image-right .two-side__image-container {
    order: 2;
  }
  .section-{{ section.id }}.image-right .two-side__content {
    order: 1;
  }
  .section-{{ section.id }} .two-side__image-container {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    perspective: 1200px;
  }
  .section-{{ section.id }} .two-side__bg-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ section.settings.image_radius }}px;
    aspect-ratio: {% case section.settings.bg_image_ratio %}
      {% when 'square' %}1/1
      {% when 'portrait' %}3/4
      {% else %}auto
    {% endcase %};
    opacity: 0.7;
    object-fit: cover;
  }
  .two-side__centered-image {
    position: absolute;
    width: 50%;
    z-index: 2;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    /* border: 0.5px solid #ccc; */
  }
  .two-side__centered-image img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: {% case section.settings.centered_image_ratio %}
      {% when 'square' %}1/1
      {% when 'portrait' %}3/4
      {% else %}auto
    {% endcase %};
    object-fit: cover;
  }
  .section-{{ section.id }} .two-side__content {
    text-align: {{ section.settings.text_align }};
    color: {{ section.settings.text_color }};
    background: {{ section.settings.content_bg }};
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 40px;
    align-items: 
    {% case section.settings.text_align %}
        {% when 'left' %} flex-start
        {% when 'center' %} center
        {% when 'right' %} flex-end
    {% endcase %};
  }

  .section-{{ section.id }} .two-side__heading {
    margin-bottom: 16px;
  }

  .section-{{ section.id }} .two-side__text {
    margin-bottom: 20px;
    color: {{ section.settings.secondary_text_color }};
  }

  .section-{{ section.id }} .two-side__button {
    display: inline-block;
    transition: all 0.3s ease;
    max-width: 100%;
    width: auto%
  }

  .section-{{ section.id }} .btn--fill {
    background: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text }};
    border: 1px solid {{ section.settings.btn_border }};
    padding: 12px 24px;
  }

  .section-{{ section.id }} .btn--fill:hover {
    background: {{ section.settings.btn_bg_hover }};
    color: {{ section.settings.btn_text_hover }};
    border-color: {{ section.settings.btn_border_hover }};
  }

  .section-{{ section.id }} .btn--outline {
    background: transparent;
    color: {{ section.settings.btn_text }};
    border: 1px solid {{ section.settings.btn_border }};
    padding: 12px 24px;
  }

  .section-{{ section.id }} .btn--outline:hover {
    background: {{ section.settings.btn_bg_hover }};
    color: {{ section.settings.btn_text_hover }};
  }

  .section-{{ section.id }} .btn--link {
    background: none;
    border: none;
    padding: 0;
    color: {{ section.settings.btn_text }};
    text-decoration: underline;
  }

  .section-{{ section.id }} .btn--link:hover {
    color: {{ section.settings.btn_text_hover }};
  }

  @media (max-width: 749px) {
    .section-{{ section.id }} {
      grid-template-columns: 1fr;
    }

    .section-{{ section.id }}.mobile-reverse .two-side__image-container {
      order: 2;
    }

    .section-{{ section.id }}.mobile-reverse .two-side__content {
      order: 1;
    }

    .section-{{ section.id }} .two-side__content {
      text-align: {{ section.settings.text_align_mobile }};
    }
  }

.two-side__centered-image {
  position: absolute;
  width: 60%;
  z-index: 2;
  top: 50%;
  left: 50%;
  overflow: hidden;
  /* border: 0.5px solid #ccc; */
  
  /* Initial centering + dynamic variables */
  transform: translate(calc(-50% + var(--move-x, 0px)), calc(-50% + var(--move-y, 0px))) 
             rotateX(var(--rotate-x, 0deg)) 
             rotateY(var(--rotate-y, 0deg));

  /* SLOWER MOTION: 0.8s with a very smooth entry curve */
  transition: transform 0.8s cubic-bezier(0.15, 0.85, 0.35, 1);
  will-change: transform;
  cursor: pointer;
}

.two-side__centered-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(var(--inner-zoom, 1));
  /* SLOWER INNER ZOOM: matched to the frame */
  transition: transform 1.2s cubic-bezier(0.15, 0.85, 0.35, 1);
}

{% endstyle %}

<div
  class="two-side-section section-{{ section.id }} {{ section.settings.vertical_alignment }}{%  if section.settings.full_width %} full-width{% endif %}{% if section.settings.layout == 'image_right' %} image-right{% endif %}{% if section.settings.mobile_layout == 'content_first' %} mobile-reverse{% endif %}"
  id="section-{{ section.id }}"
>
  <div class="two-side__image-container" id="AnimationContainer-{{ section.id }}">
    <div class="two-side__bg-image">
      {% if section.settings.bg_image != blank %}
        {{
          section.settings.bg_image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '375,550,750,1100,1500',
            alt: section.settings.bg_image.alt
        }}
      {% endif %}
    </div>
    <div class="two-side__centered-image">
      {% if section.settings.centered_image != blank %}
        {{
          section.settings.centered_image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '375,550,750,1100,1500',
            alt: section.settings.centered_image.alt
        }}
      {% endif %}
    </div>
  </div>

  <div class="two-side__content p-10">
    {% if section.settings.heading != blank %}
      <h2 class="two-side__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="two-side__text {{ section.settings.text_style }}">{{ section.settings.text }}</div>
    {% endif %}

    {% if section.settings.btn_label != blank %}
      <a
        href="{{ section.settings.btn_link }}"
        class="two-side__button btn--{{ section.settings.btn_style }}"
      >
        {{ section.settings.btn_label }}
      </a>
    {% endif %}
  </div>
</div>
<script>
(function() {
  const initSlowAnimation = () => {
    const container = document.querySelector('#AnimationContainer-{{ section.id }}');
    const frame = container?.querySelector('.two-side__centered-image');
    const img = frame?.querySelector('img');

    if (!container || !frame || !img) return;

    container.addEventListener('mousemove', (e) => {
      const rect = container.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;

      // Lower multipliers make the motion feel more controlled/less "wild"
      const moveX = x * 30; 
      const moveY = y * 30;
      const rotY = x * 8;
      const rotX = y * -8;

      frame.style.setProperty('--move-x', `${moveX}px`);
      frame.style.setProperty('--move-y', `${moveY}px`);
      frame.style.setProperty('--rotate-y', `${rotY}deg`);
      frame.style.setProperty('--rotate-x', `${rotX}deg`);
    });

    container.addEventListener('mouseenter', () => {
      // Set inner zoom
      img.style.setProperty('--inner-zoom', '1.15');
      // Keep transition duration relatively high even on move for that "floaty" feel
      frame.style.transition = 'transform 0.8s cubic-bezier(0.15, 0.85, 0.35, 1)';
    });

    container.addEventListener('mouseleave', () => {
      // Slower reset for a graceful exit
      frame.style.transition = 'transform 1.2s cubic-bezier(0.15, 0.85, 0.35, 1)';
      img.style.setProperty('--inner-zoom', '1');
      frame.style.setProperty('--move-x', '0px');
      frame.style.setProperty('--move-y', '0px');
      frame.style.setProperty('--rotate-y', '0deg');
      frame.style.setProperty('--rotate-x', '0deg');
    });
  };

  document.addEventListener('DOMContentLoaded', initSlowAnimation);
  if (window.Shopify && Shopify.designMode) {
    document.addEventListener('shopify:section:load', initSlowAnimation);
  }
})();
</script>

{% schema %}
{
  "name": "Two images with text",
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    {
      "type": "select",
