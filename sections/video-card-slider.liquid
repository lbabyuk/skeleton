{%- style -%}
    .section-{{ section.id }} .swiper-button-next,
    .section-{{ section.id }} .swiper-button-prev,
    .section-{{ section.id }} .swiper-pagination-bullet-active {
      color: {{ section.settings.nav_color }};
      background-color: transparent;
    }
    .section-{{ section.id }} .swiper-pagination-bullet-active {
      background-color: {{ section.settings.nav_color }};
    }

     .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mb }}px;
      padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
    .section-{{ section.id }} {
      background-color: {{ section.settings.section_bg }};
    }

  .v-card {
      position: relative;
      display: flex;
      flex-direction: column;
      height: 100%;
      border-radius: 8px;
      transition: transform 0.3s ease;
      overflow: hidden;
      background-color: var(--card-bg, #ffffff);
      border: 1px solid var(--card-border-bg, transparent);
    }

    .section__heading {
      padding-bottom: 32px;
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content:center;
      align-items: center;
      gap: 16px;
    }


    {% for block in section.blocks %}
      .block-{{ block.id }} {
        --card-bg: {{ block.settings.card_bg }};
        --card-border-bg: {{ block.settings.card_border_bg }};
      }
    {% endfor %}
    .v-card__header {
      display: flex;
      align-items: center;
      gap: 12px;
      background: #FFFFFF80;
      backdrop-filter: blur(10px);
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      padding: 10px 16px;
    }
    .v-card__avatar {
        width: 40px;
        height: 40px;
        object-fit: cover;
        display: block;
        border-radius: 50%;
    }
    .v-card__user-meta {
      line-height: 1.2;
    }

    .v-card__name {
       font-weight: 600;
       font-size: 16px;
       color: #000;
      }

    .v-card__position {
        font-weight: 400;
       font-size: 14px;
       color: #777;
       margin: 0;
      }


    .v-card__video-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      background: #f4f4f4;
    }
    .v-card__video { width: 100%; height: 100%; object-fit: cover; }
    .v-card__footer {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      flex-grow: 1;
      background: #ECF166E5;
      backdrop-filter: blur(10px);
      padding: 0 14px 16px 14px;
      gap: 8px;
    }
    .v-card__footer-icon {
      width: 24px; height: 24px; object-fit: contain; opacity: 0.8;
    }
    .v-card__footer-text {
      font-size: 14px;
        line-height: 19px;
        font-weight: 500;
        text-align: left;
        margin-top: 13px;
        background: {{  }}
        }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding  section-{{ section.id }}">
  <div class="section__heading">
    {% if section.settings.heading != blank %}
      <h2 class="video-slider__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="video-slider__text {{ section.settings.text_style }}">{{ section.settings.text }}</div>
    {% endif %}
  </div>

  <div class="video-slider" data-section-id="{{ section.id }}">
    <div class="video-slider__wrapper">
      <div class="swiper js-video-swiper">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            <div class="swiper-slide block-{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="v-card">
                <div class="v-card__header">
                  {%- if block.settings.user_image -%}
                    {{
                      block.settings.user_image
                      | image_url: width: 120
                      | image_tag: class: 'v-card__avatar', loading: 'lazy'
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'v-card__avatar' }}
                  {%- endif -%}
                  <div class="v-card__user-meta">
                    <p class="v-card__name">{{ block.settings.user_name }}</p>
                    <p class="v-card__position">{{ block.settings.user_position }}</p>
                  </div>
                </div>

                <div class="v-card__video-container">
                  {%- if block.settings.video_url != blank -%}
                    {{
                      block.settings.video_url
                      | video_tag: controls: true, class: 'v-card__video', image_size: '600x'
                    }}
                  {%- endif -%}
                </div>

                <div class="v-card__footer">
                  {%- if block.settings.footer_icon -%}
                    {{ block.settings.footer_icon | image_url: width: 64 | image_tag: class: 'v-card__footer-icon' }}
                  {%- endif -%}
                  <p class="v-card__footer-text">{{ block.settings.footer_text }}</p>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.show_arrows -%}
          <div class="{{ section.id }}-next swiper-button-next"></div>
          <div class="{{ section.id }}-prev swiper-button-prev"></div>
        {%- endif -%}
      </div>
      {% if section.settings.show_dots %}
        <div class="{{ section.id }}-swiper-pagination swiper-pagination"></div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  const initVideoSwiper = () => {
    const container = document.querySelector('.js-video-swiper');
    if (!container) return;

    new Swiper(container, {
      slidesPerView: 1.2,
      spaceBetween: 15,
      grabCursor: true,
      pagination: {
        el: '.{{ section.id }}-swiper-pagination',
        clickable: true
      },
      navigation: {
        nextEl: '.{{ section.id }}-next',
        prevEl: '.{{ section.id }}-prev'
      },
      breakpoints: {
        768: {
          slidesPerView: 2,
          spaceBetween: 20
        },

        1024: {
          slidesPerView: 4,
          spaceBetween: 24
        }
      }
    });
  };

  document.addEventListener('shopify:section:load', initVideoSwiper);
  document.addEventListener('DOMContentLoaded', initVideoSwiper);
</script>

{% schema %}
{
  "name": "Video Card Slider",
  "settings": [
    { "type": "header", "content": "Section Settings" },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    },
    { "type": "checkbox", "id": "show_dots", "label": "Show Navigation Dots", "default": true },
    { "type": "color", "id": "nav_color", "label": " Navigation Color" },
    { "type": "color", "id": "section_bg", "label": "Section Background" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "text_style",
      "options": [
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "subtitle",
          "label": "Subtitle"
        },
        {
          "value": "caption-with-letter-spacing",
          "label": "Caption"
        }
      ],
      "default": "body",
      "label": "Subheading size"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (D)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (D)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (M)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (M)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video Card",
      "settings": [
        { "type": "header", "content": "Card settings" },
        { "type": "color", "id": "card_bg", "label": "Card Background" },
        { "type": "color", "id": "card_border_bg", "label": "Card Border Background" },
        { "type": "image_picker", "id": "user_image", "label": "User Image" },
        { "type": "text", "id": "user_name", "label": "Name", "default": "Jane Doe" },
        { "type": "text", "id": "user_position", "label": "Position", "default": "CEO, Company" },
        { "type": "color", "id": "footer_text_color", "label": "Footer Text color" },

        { "type": "header", "content": "Video" },
        { "type": "video", "id": "video_url", "label": "Shopify Hosted Video" },
        { "type": "header", "content": "Footer" },
        { "type": "image_picker", "id": "footer_icon", "label": "Bottom Left Icon" },
        {
          "type": "textarea",
          "id": "footer_text",
          "label": "Bottom Text",
          "default": "Amazing results with this product!"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Card Slider",
      "blocks": [{ "type": "video_card" }, { "type": "video_card" }, { "type": "video_card" }]
    }
  ]
}
{% endschema %}
