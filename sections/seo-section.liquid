{%- if section.blocks.size > 0 -%}
  <style>
     #shopify-section-{{ section.id }} {
       --image-with-text-content-max-width: {% if section.settings.content_width == 'sm' %}430px{% elsif section.settings.content_width == 'md' %}780px{% else %}100%{% endif %};
     }

     #shopify-section-{{ section.id }} ul li {
       list-style-type: none;
       padding-inline-start: 0;
    }
    #shopify-section-{{ section.id }} .list__content-wrapper {
      margin: 0 !important;
      text-align: left;
    }
    #shopify-section-{{ section.id }} .list__content-wrapper p, #shopify-section-{{ section.id }} .list__content-wrapper h3 {
      margin: 0 !important;
    }
    #shopify-section-{{ section.id }} .list__content-list--item {
      display: flex;
      justify-content: flex-start;
      align-items: flex-start;
      gap: 20px;
    }
    @media (max-width: 699px) {
      #shopify-section-{{ section.id }} .list__content-list--item {
        gap: 10px;
      }
    }
  </style>

  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient
    | default: section.settings.color_scheme.settings.background
    | md5
  -%}

  {%- for block in section.blocks -%}
    <div class="{% unless section.settings.remove_vertical_spacing %}section-spacing{% endunless %} color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
      <image-with-text class="image-with-text {% if block.settings.image_position == 'end' %}image-with-text--reverse{% endif %}">
        {%- case block.type -%}
          {%- when 'item' -%}
            {%- if block.settings.image_desktop != blank -%}
              <picture>
                {%- assign sizes = '(max-width: 699px) 100vw, 50vw' -%}

                {%- if block.settings.image_mobile != blank -%}
                  <source
                    media="(max-width: 699px)"
                    srcset="{{ block.settings.image_mobile | image_url: width: '400x' }} 400w, {{ block.settings.image_mobile | image_url: width: '600x' }} 600w, {{ block.settings.image_mobile | image_url: width: '800x' }} 800w, {{ block.settings.image_mobile | image_url: width: '1000x' }} 1000w"
                    width="{{ block.settings.image_mobile.width }}"
                    height="{{ block.settings.image_mobile.height }}"
                  >
                {%- endif -%}

                {{-
                  block.settings.image_desktop
                  | image_url: width: block.settings.image_desktop.width
                  | image_tag:
                    sizes: sizes,
                    widths: '200,300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200',
                    reveal-on-scroll: block.settings.reveal_on_scroll
                -}}
              </picture>
            {%- else -%}
              {{- 'image' | placeholder_svg_tag: 'placeholder' -}}
            {%- endif -%}

            <div class="prose text-center sm:text-start">
              {%- if block.settings.subheading_text != blank -%}
                <p class="h6">{{ block.settings.subheading_text }}</p>
              {%- endif -%}

              {%- if block.settings.heading_text != blank -%}
                <h2 class="h2">
                  {{ block.settings.heading_text }}
                </h2>
              {%- endif -%}

              {%- if block.settings.description_content != blank -%}
                <div>
                  {{- block.settings.description_content -}}
                </div>
              {%- endif -%}

              {%- if block.settings.list_title_1 != blank
                or block.settings.list_content_1 != blank
                or block.settings.list_icon_1 != blank
                or block.settings.list_title_2 != blank
                or block.settings.list_content_2 != blank
                or block.settings.list_icon_2 != blank
                or block.settings.list_title_3 != blank
                or block.settings.list_content_3 != blank
                or block.settings.list_icon_3 != blank
              -%}
                <ul class="list__content-list">
                  {%- for i in (1..3) -%}
                    {%- assign icon_key = 'list_icon_' | append: i -%}
                    {%- assign title_key = 'list_title_' | append: i -%}
                    {%- assign content_key = 'list_content_' | append: i -%}

                    {%- assign icon = block.settings[icon_key] -%}
                    {%- assign title = block.settings[title_key] -%}
                    {%- assign content = block.settings[content_key] -%}

                    {%- if icon != blank or title != blank or content != blank -%}
                      <li class="list__content-list--item">
                        {%- if icon != blank -%}
                          {{ icon | image_url: width: 30 | image_tag: loading: 'lazy', width: 30, class: 'list-icon' }}
                        {%- endif -%}

                        <div class="list__content-wrapper">
                          {%- if title != blank -%}
                            <h3 class="list_title h3">{{ title }}</h3>
                          {%- endif -%}

                          {%- if content != blank -%}
                            {{ content }}
                          {%- endif -%}
                        </div>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if block.settings.page.content != blank -%}
                <div>
                  {{- block.settings.page.content -}}
                </div>
              {%- endif -%}

              {%- if block.settings.liquid != blank -%}
                <div>
                  {{- block.settings.liquid -}}
                </div>
              {%- endif -%}
              <a
                {% if block.settings.link_url %}
                  href="{{ block.settings.link_url }}"
                {% endif %}
                class="link"
              >
                {{- block.settings.link_text | escape -}}
              </a>

              {%- if block.settings.button_text != blank -%}
                {% render 'button',
                  content: block.settings.button_text,
                  href: block.settings.button_url,
                  background: section.settings.button_background,
                  text_color: section.settings.button_text_color,
                  block: block
                %}
              {%- endif -%}
            </div>
        {% endcase %}
      </image-with-text>
    </div>
  {%- endfor -%}
{%- endif -%}

{% schema %}
{
  "name": "SEO image with text",
  "class": "shopify-section--seo-image-with-text",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    /*{
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "remove_vertical_spacing",
      "label": "t:global.spacing.remove_vertical_spacing",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reveal_on_scroll",
      "label": "t:global.animation.reveal_image_on_scroll",
      "default": true
    },*/
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        }
      ],
      "default": "sm"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "richtext",
          "id": "subheading_text",
          "label": "Subheading"
        },

        {
          "type": "richtext",
          "id": "heading_text",
          "label": "Heading"
        },

        {
          "type": "header",
          "content": "Description"
        },
        {
          "type": "richtext",
          "id": "description_content",
          "label": "Description content"
        },
        {
          "type": "header",
          "content": "List content"
        },
        {
          "type": "image_picker",
          "id": "list_icon_1",
          "label": "List icon 1"
        },
        {
          "type": "text",
          "id": "list_title_1",
          "label": "List title 1"
        },
        {
          "type": "richtext",
          "id": "list_content_1",
          "label": "List content 1"
        },
        {
          "type": "image_picker",
          "id": "list_icon_2",
          "label": "List icon 2"
        },
        {
          "type": "text",
          "id": "list_title_2",
          "label": "List title 2"
        },
        {
          "type": "richtext",
          "id": "list_content_2",
          "label": "List content 2"
        },
        {
          "type": "image_picker",
          "id": "list_icon_3",
          "label": "List icon 3"
        },
        {
          "type": "text",
          "id": "list_title_3",
          "label": "List title 3"
        },
        {
          "type": "richtext",
          "id": "list_content_3",
          "label": "List content 3"
        },
        {
          "type": "header",
          "content": "Image settings"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Image(desktop)",
          "info": "t:sections.image_with_text.image_size_recommendation"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image(mobile)",
          "info": "t:sections.image_with_text.mobile_image_size_recommendation"
        },

        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            {
              "value": "start",
              "label": "Left"
            },
            {
              "value": "end",
              "label": "Right"
            }
          ],
          "default": "start"
        },

        {
          "type": "header",
          "content": "Link Settings"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "link url"
        },
        {
          "type": "header",
          "content": "Button settings"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "t:global.text.text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        },

        {
          "type": "page",
          "id": "page",
          "label": "Page"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SEO PLP image with text",
      "blocks": [
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
